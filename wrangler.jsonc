{
  // Static-asset Worker: no script, no runtime, nothing to execute per request. Cloudflare serves the
  // built files directly, which is why the deployment has no cold start and no adapter.
  "name": "fituous-landing",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // Single-page behaviour: any unknown path serves the page rather than a bare 404. There is no router
    // today, so this only matters if the page is linked with a path like /privacy.
    "not_found_handling": "single-page-application"
  }
}
